# Docker Environment Configuration for ask_llm
# Copy this file to .env and fill in your values.
# This single .env is used for docker-compose substitution and app runtime config.

# Build
WITH_CUDA=true
CUDA_ARCHS=120

# Ports (host -> container)
MCP_PORT=8001
SERVICE_PORT=8642

# Paths
MODELS_PATH=./models
ASK_LLM_MODEL_CACHE_DIR=~/.cache/ask_llm/models
HF_HOME=~/.cache/huggingface

# Core
ASK_LLM_DEFAULT_BOT=nova
ASK_LLM_DEFAULT_MODEL_ALIAS=gpt-5.2-chat-latest
ASK_LLM_DEFAULT_USER=user
ASK_LLM_USE_SERVICE=true
ASK_LLM_SERVICE_HOST=0.0.0.0
ASK_LLM_SERVICE_PORT=8642
ASK_LLM_MEMORY_SERVER_URL=http://127.0.0.1:8001
ASK_LLM_LOG_DIR=.logs
ASK_LLM_LOG_PREFIX=docker
ASK_LLM_DEBUG_TURN_LOG=false
ASK_LLM_HISTORY_DURATION=1800
ASK_LLM_MAX_TOKENS=4096

# Llama.cpp (optional)
ASK_LLM_LLAMA_CPP_N_CTX=8192
ASK_LLM_LLAMA_CPP_N_GPU_LAYERS=-1
ASK_LLM_LLAMA_CPP_N_BATCH=1024
ASK_LLM_LLAMA_CPP_FLASH_ATTN=true

# PostgreSQL
ASK_LLM_POSTGRES_HOST=localhost
ASK_LLM_POSTGRES_PORT=5432
ASK_LLM_POSTGRES_USER=askllm
ASK_LLM_POSTGRES_PASSWORD=
ASK_LLM_POSTGRES_DATABASE=askllm

# Search
ASK_LLM_SEARCH_PROVIDER=duckduckgo
ASK_LLM_TAVILY_API_KEY=
ASK_LLM_BRAVE_API_KEY=

# Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Nextcloud Talk (optional)
ASK_LLM_NEXTCLOUD_URL=https://nextcloud.example.com
ASK_LLM_NEXTCLOUD_BOT_SECRET=
ASK_LLM_TALK_PROVISIONER_URL=http://localhost:8790
ASK_LLM_TALK_PROVISIONER_TOKEN=

# Transformers / HF behavior
HF_HUB_DISABLE_PROGRESS_BARS=1
TRANSFORMERS_NO_ADVISORY_WARNINGS=1
TRANSFORMERS_VERBOSITY=error
TOKENIZERS_PARALLELISM=false
